  modal('<div class="mh"><h3>استيراد طلاب</h3><button class="btn gray sm" data-act="close">✕</button></div><p>الصق الأعمدة من Excel أو اختر ملف CSV (UTF-8) بهذا الترتيب: <b>الاسم، اسم المستخدم، كلمة المرور، الصف، الهاتف، البريد، المستوى</b>. كلمة المرور الفارغة تُولَّد تلقائيًا (6 أحرف على الأقل). اسم الصف يجب أن يطابق اسمه في المنصة.</p><form data-sub="importstu"><label class="fld"><span>الصف الافتراضي (عند ترك عمود الصف فارغًا)</span><select name="c"><option value="">— بدون —</option>' + clsOpts('', false) + '</select></label><label class="fld"><span>الصق البيانات هنا</span><textarea name="t" rows="8" style="direction:ltr"></textarea></label><label class="fld"><span>أو اختر ملف CSV/TXT</span><input type="file" name="f" accept=".csv,.txt,text/csv,text/plain"></label><label class="chk"><input type="checkbox" name="h"> السطر الأول عناوين (تجاهله)</label><div class="mf"><button class="btn" type="submit">استيراد</button></div></form><div id="impres"></div>', 'lg');
};
function parseRows(txt, skipHeader) {
  var lines = txt.replace(/\r/g, '').split('\n').filter(function (l) { return l.trim(); });
  if (skipHeader) lines.shift();
  return lines.map(function (l) { var sep = l.indexOf('\t') >= 0 ? '\t' : ','; return l.split(sep).map(function (x) { return x.trim().replace(/^"|"$/g, ''); }); });
}
SUB.importstu = function (f) {
  var go = function (text) {
    var rows = parseRows(text, f.h.checked), btn = f.querySelector('button[type=submit]');
    if (!rows.length) { toast('لا توجد بيانات', 'err'); return; }
    btn.disabled = true;
    var created = [], errors = [], i = 0, total = rows.length;
    (function next() {
      if (i >= total) {
        btn.disabled = false;
        $('#impres').innerHTML = '<h3>تم إنشاء ' + created.length + ' من ' + total + '</h3>' + (errors.length ? '<div class="card" style="border-color:var(--err)">' + errors.map(esc).join('<br>') + '</div>' : '') + (created.length ? '<p>احفظ هذه الأسماء وكلمات المرور الآن، فلن تظهر كلمات المرور بعد إغلاق النافذة:</p><textarea class="inp" rows="8" readonly style="direction:ltr">' + esc(created.map(function (c) { return c.name + '\t' + c.username + '\t' + c.password; }).join('\n')) + '</textarea>' : '');
        return;
      }
      var chunk = rows.slice(i, i + 25);
      $('#impres').innerHTML = '<p>جارٍ الاستيراد… ' + Math.min(i + 25, total) + ' / ' + total + '</p>';
      A('admin_importStudents', { rows: chunk, defaultClassId: f.c.value, offset: i }).then(function (r) { created = created.concat(r.created); errors = errors.concat(r.errors); i += 25; next(); }).catch(function () { btn.disabled = false; });
    })();
  };
  var file = f.f.files[0];
  if (file) { var r = new FileReader(); r.onload = function () { go(String(r.result)); }; r.readAsText(file, 'utf-8'); }
  else go(f.t.value);
};

