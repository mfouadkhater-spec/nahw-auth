/** ينفّذ عملية على دفعات (25 عنصرًا لكل طلب) مع شريط تقدّم. */
function chunkRun(action, base, ids, title, done) {
  modal('<div class="mh"><h3>' + esc(title) + '</h3></div><p id="chk">جارٍ التنفيذ…</p><div class="progress"><i id="chkbar" style="width:0"></i></div><div id="chkres"></div>');
  var i = 0, ok = 0, fail = 0, errs = [], size = 25;
  (function next() {
    if (i >= ids.length) {
      $('#chk').textContent = 'اكتمل: ' + ok + ' تم' + (fail ? ' — ' + fail + ' فشل' : '');
      $('#chkbar').style.width = '100%';
      $('#chkres').innerHTML = (errs.length ? '<p style="color:var(--err)">' + errs.map(esc).join('<br>') + '</p>' : '') + '<div class="mf"><button class="btn" data-act="close">إغلاق</button></div>';
      if (done) done(ok, fail);
      return;
    }
    var chunk = ids.slice(i, i + size);
    $('#chk').textContent = 'جارٍ التنفيذ… ' + Math.min(i + size, ids.length) + ' / ' + ids.length;
    $('#chkbar').style.width = Math.round(i / ids.length * 100) + '%';
    A(action, Object.assign({}, base, { ids: chunk })).then(function (r) {
      ok += (r.deleted !== undefined ? r.deleted : r.updated); fail += r.failed; errs = errs.concat(r.errors || []); i += size; next();
    }).catch(function () { fail += ids.length - i; i = ids.length; next(); });
  })();
}
