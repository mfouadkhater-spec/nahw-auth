<style>
:root{
  --c-primary:#12284c;--c-secondary:#1d3f72;--c-accent:#c9a227;--c-bg:#faf6ec;--c-text:#1b2433;--c-header:#12284c;--c-footer:#0c1b36;--c-btn:#c9a227;--c-btnText:#12284c;
  --radius:16px;--font:'Cairo',Tahoma,sans-serif;--fontH:'Amiri','Cairo',serif;--fs:16px;
  --bg:var(--c-bg);--text:var(--c-text);--surface:#ffffff;--muted:#667085;--border:#e8dfc6;--head:var(--c-primary);
  --btn:var(--c-btn);--btnText:var(--c-btnText);--shadow:0 8px 28px rgba(18,40,76,.08);--ok:#15803d;--err:#dc2626;--warn:#b45309;--soft:#f4efe0;
}
[data-theme=dark]{
  --bg:#0b1525;--text:#f2ebd8;--surface:#122139;--muted:#9fb0c8;--border:#22355a;--head:#ead9a2;
  --btn:var(--c-accent);--btnText:#0b1525;--shadow:0 8px 28px rgba(0,0,0,.4);--soft:#18294a;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);font-size:var(--fs);line-height:1.8;padding-bottom:68px;transition:background .25s,color .25s}
body.adm{padding-bottom:0}
h1,h2,h3,h4{font-family:var(--fontH);color:var(--head);margin:0 0 .5em;line-height:1.4}
.hero h1{font-family:var(--fontHero,var(--fontH))}
.brand,.side .sb{font-family:var(--fontBrand,var(--fontH))}
a{color:inherit;text-decoration:none;cursor:pointer}
img{max-width:100%}
img.broken{visibility:hidden}
.wrap{max-width:1180px;margin:0 auto;padding:0 18px}
[hidden]{display:none!important}
/* loading */
#topbar{position:fixed;top:0;inset-inline:0;height:3px;z-index:9999;background:linear-gradient(90deg,var(--c-accent),var(--c-secondary));transform:scaleX(0);transform-origin:right;transition:transform .4s;opacity:0}
#topbar.on{opacity:1;transform:scaleX(.85)}
#splash{position:fixed;inset:0;display:flex;flex-direction:column;gap:12px;align-items:center;justify-content:center;background:var(--bg);z-index:9000}
.spin{width:22px;height:22px;border:3px solid var(--border);border-top-color:var(--c-accent);border-radius:50%;animation:sp .8s linear infinite;display:inline-block}
.spin.big{width:48px;height:48px;border-width:4px}
@keyframes sp{to{transform:rotate(360deg)}}
.loading{display:flex;justify-content:center;padding:60px 0}
/* timeline / chat / bell / print */
.feed{display:grid;gap:18px;max-width:780px;margin:auto}
.post.pinned{border:2px solid var(--c-accent)}
.post .ph-h{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-bottom:8px}
.post .ph-h small{margin-inline-start:auto;color:var(--muted)}
.post-img{width:100%;border-radius:calc(var(--radius) - 4px);margin:8px 0;max-height:480px;object-fit:cover}
.bell{position:relative}
.bell .dot{position:absolute;top:-4px;inset-inline-start:-4px;background:var(--err);color:#fff;border-radius:20px;font-size:.7rem;min-width:18px;height:18px;line-height:18px;text-align:center;padding:0 4px}
.chat{display:flex;flex-direction:column;gap:8px;max-height:55vh;overflow-y:auto;padding:6px}
.chat .m{max-width:80%;padding:9px 14px;border-radius:16px;background:var(--soft);border:1px solid var(--border);white-space:pre-wrap}
.chat .m.me{align-self:flex-start;background:var(--c-primary);color:#fff;border-color:transparent}
.chat .m small{display:block;opacity:.7;font-size:.72rem;margin-top:3px}
.notif{display:block;padding:10px 12px;border-radius:12px;border:1px solid var(--border);margin-bottom:8px;cursor:pointer}
.notif.unread{background:rgba(201,162,39,.15);border-color:var(--c-accent)}
.notif small{color:var(--muted)}
.rank-me{background:rgba(201,162,39,.2)}
#print-root{display:none}
@media print{body>*:not(#print-root){display:none!important}#print-root{display:block!important;padding:20px;color:#000;background:#fff}#print-root table{min-width:0}}
/* header */
#hdr{position:sticky;top:0;z-index:500;background:var(--c-header);color:#fff;box-shadow:0 2px 14px rgba(0,0,0,.18)}
.hrow{display:flex;align-items:center;gap:14px;min-height:66px}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--fontH);font-size:1.35rem;font-weight:700;color:#fff;white-space:nowrap}
.brand img{width:44px;height:44px;border-radius:12px;object-fit:cover;background:#fff}
#nav{display:flex;gap:4px;margin-inline-start:auto;align-items:center}
#nav>a,.dd>a{padding:8px 12px;border-radius:10px;color:#e8edf7;font-weight:600;font-size:.93rem;display:inline-flex;gap:4px;align-items:center}
#nav>a:hover,.dd:hover>a{background:rgba(255,255,255,.12)}
.dd{position:relative}
.ddm{position:absolute;top:100%;inset-inline-start:0;min-width:200px;background:var(--surface);color:var(--text);border-radius:12px;box-shadow:var(--shadow);border:1px solid var(--border);padding:6px;display:none}
.dd:hover .ddm{display:block}
.ddm a{display:block;padding:9px 12px;border-radius:8px;color:var(--text)}
.ddm a:hover{background:var(--soft)}
.hact{display:flex;gap:8px;align-items:center}
.ib{background:rgba(255,255,255,.12);border:0;color:#fff;width:40px;height:40px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.ib:hover{background:rgba(255,255,255,.22)}
.mnu{display:none}
/* buttons / forms */
.btn{background:var(--btn);color:var(--btnText);border:0;border-radius:calc(var(--radius) - 4px);padding:11px 22px;font:700 1rem var(--font);cursor:pointer;display:inline-flex;gap:8px;align-items:center;justify-content:center;transition:transform .15s,box-shadow .15s}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(0,0,0,.18)}
.btn:disabled{opacity:.55;cursor:not-allowed;transform:none}
.btn.sm{padding:7px 14px;font-size:.88rem}
.btn.ghost{background:transparent;color:var(--head);border:2px solid var(--c-accent)}
.btn.light{background:rgba(255,255,255,.14);color:#fff;border:1px solid rgba(255,255,255,.4)}
.btn.danger{background:var(--err);color:#fff}
.btn.gray{background:var(--soft);color:var(--text);border:1px solid var(--border)}
.fld{display:flex;flex-direction:column;gap:6px;margin-bottom:14px;font-weight:600;font-size:.92rem}
.fld input,.fld select,.fld textarea,.inp{font:inherit;font-weight:400;padding:10px 13px;border:1.5px solid var(--border);border-radius:12px;background:var(--surface);color:var(--text);width:100%}
.fld input:focus,.fld select:focus,.fld textarea:focus,.inp:focus{outline:none;border-color:var(--c-accent);box-shadow:0 0 0 3px rgba(201,162,39,.25)}
.fld input[type=color]{padding:3px;height:44px}
.fld input[type=checkbox]{width:20px;height:20px}
.chk{display:flex;gap:8px;align-items:center;font-weight:600;margin-bottom:14px}
.fgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:0 16px}
.up{display:flex;gap:8px;align-items:center}
.up input{flex:1}
.pv{width:44px;height:44px;border-radius:10px;object-fit:cover;border:1px solid var(--border)}
/* cards */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px}
body[data-card=SOFT] .card{box-shadow:var(--shadow)}
body[data-card=FLAT] .card{box-shadow:none}
body[data-card=OUTLINE] .card{box-shadow:none;border:2px solid var(--c-accent)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:20px}
.item{padding:0;overflow:hidden;cursor:pointer;transition:transform .2s}
.item:hover{transform:translateY(-4px)}
.thumb{position:relative;aspect-ratio:16/9;background:linear-gradient(135deg,var(--c-primary),var(--c-secondary));display:flex;align-items:center;justify-content:center;color:var(--c-accent);overflow:hidden}
.thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.thumb .ph{opacity:.85}
.lockb{position:absolute;top:10px;inset-inline-start:10px;background:rgba(0,0,0,.7);color:#fff;border-radius:20px;padding:2px 10px;font-size:.78rem;display:flex;gap:4px;align-items:center}
.feat{position:absolute;top:8px;inset-inline-end:10px;color:var(--c-accent);font-size:1.3rem;text-shadow:0 1px 4px #000}
.item.locked .thumb::after{content:"";position:absolute;inset:0;background:rgba(10,20,40,.45)}
.item.locked .lockb{z-index:2}
.cb{padding:14px 16px 16px}
.cb h3{font-size:1.1rem;margin-bottom:.3em}
.cb p{margin:0 0 8px;color:var(--muted);font-size:.9rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.meta{display:flex;gap:6px;flex-wrap:wrap}
.badge{background:var(--soft);color:var(--text);border:1px solid var(--border);border-radius:20px;padding:1px 10px;font-size:.78rem;font-weight:600;display:inline-block}
.badge.ok{background:rgba(21,128,61,.12);color:var(--ok);border-color:transparent}
.badge.err{background:rgba(220,38,38,.12);color:var(--err);border-color:transparent}
.badge.warn{background:rgba(180,83,9,.12);color:var(--warn);border-color:transparent}
/* sections */
.sec{padding:54px 0}
.sec.alt{background:var(--soft)}
.sec-h{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:24px;flex-wrap:wrap}
.sec-h h2{font-size:1.9rem;margin:0;position:relative;padding-bottom:10px}
.sec-h h2::after{content:"";position:absolute;bottom:0;inset-inline-start:0;width:60px;height:4px;border-radius:4px;background:var(--c-accent)}
.hero{background:radial-gradient(circle at 80% 20%,var(--c-secondary),var(--c-primary) 70%);color:#fff;padding:64px 0 74px;position:relative;overflow:hidden}
.hero::before{content:"ن ح و";position:absolute;inset-inline-end:-20px;top:-30px;font:700 15rem/1 var(--fontH);opacity:.05;white-space:nowrap}
.hero .wrap{display:grid;grid-template-columns:1.3fr 1fr;gap:30px;align-items:center;position:relative}
.hero h1{color:#fff;font-size:clamp(2.2rem,5vw,3.6rem);margin-bottom:.2em}
.hero .sl{color:var(--c-accent);font-size:1.25rem;font-weight:700;margin-bottom:14px}
.typed{min-height:5.4em;font-size:1.1rem;color:#dfe7f5;margin-bottom:20px}
.typed::after{content:"|";color:var(--c-accent);animation:bl 1s steps(2) infinite}
@keyframes bl{50%{opacity:0}}
.cta{display:flex;gap:12px;flex-wrap:wrap}
.hero-art{display:flex;justify-content:center}
.hero-art .frame{width:min(320px,80%);aspect-ratio:1;border-radius:50%;border:5px solid var(--c-accent);background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:0 0 0 14px rgba(201,162,39,.15)}
.hero-art img{width:100%;height:100%;object-fit:cover}
.cls-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}
.cls-card{text-align:center;cursor:pointer;transition:transform .2s;border-top:5px solid var(--c-accent)}
.cls-card:hover{transform:translateY(-5px)}
.cls-card .num{width:62px;height:62px;border-radius:50%;margin:0 auto 10px;background:var(--c-primary);color:var(--c-accent);display:flex;align-items:center;justify-content:center;font:700 1.8rem var(--fontH)}
.why{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
.why .card{text-align:center}
.why .ic{color:var(--c-accent)}
.about{display:grid;grid-template-columns:300px 1fr;gap:34px;align-items:center}
.about .pic{aspect-ratio:1;border-radius:var(--radius);overflow:hidden;border:4px solid var(--c-accent);background:var(--soft)}
.about .pic img{width:100%;height:100%;object-fit:cover}
.about ul{padding-inline-start:20px}
.contact-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.contact-grid a{display:flex;gap:12px;align-items:center;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;font-weight:700}
.contact-grid a:hover{border-color:var(--c-accent)}
.contact-grid .ic{color:var(--c-accent)}
.page{padding:34px 0 50px;min-height:60vh}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px;align-items:center}
.toolbar .inp{width:auto;min-width:150px;flex:1}
.pager{display:flex;gap:6px;justify-content:center;margin-top:24px;flex-wrap:wrap}
.pager button{min-width:38px;height:38px;border-radius:10px;border:1px solid var(--border);background:var(--surface);color:var(--text);font:inherit;cursor:pointer}
.pager button.cur{background:var(--c-primary);color:#fff;border-color:var(--c-primary)}
.empty{text-align:center;padding:50px 10px;color:var(--muted)}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px;border-bottom:2px solid var(--border)}
.tabs button{background:none;border:0;border-bottom:3px solid transparent;padding:10px 16px;font:700 .95rem var(--font);color:var(--muted);cursor:pointer;margin-bottom:-2px}
.tabs button.on{color:var(--head);border-color:var(--c-accent)}
.player{position:relative;aspect-ratio:16/9;background:#000;border-radius:var(--radius);overflow:hidden}
.player iframe,.player video{position:absolute;inset:0;width:100%;height:100%;border:0}
.two{display:grid;grid-template-columns:2fr 1fr;gap:24px}
.progress{height:12px;background:var(--border);border-radius:10px;overflow:hidden}
.progress i{display:block;height:100%;background:linear-gradient(90deg,var(--c-accent),#e5c565);border-radius:10px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:16px;margin-bottom:22px}
.stat{text-align:center}
.stat b{display:block;font:700 2rem var(--fontH);color:var(--head)}
.stat span{color:var(--muted);font-size:.88rem}
.tbl-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}
table{border-collapse:collapse;width:100%;min-width:560px}
th,td{padding:10px 14px;text-align:start;border-bottom:1px solid var(--border);font-size:.92rem;vertical-align:middle}
th{background:var(--soft);font-weight:700;white-space:nowrap}
tr:last-child td{border-bottom:0}
.acts{display:flex;gap:5px;flex-wrap:wrap}
.acts .btn{padding:5px 10px;font-size:.8rem}
/* exam */
.exbar{position:sticky;top:66px;z-index:50;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:18px}
.timer{font:700 1.4rem var(--font);color:var(--err);direction:ltr}
.q{margin-bottom:16px}
.q h4{font-family:var(--font);font-size:1.05rem}
.ch{display:flex;gap:10px;align-items:center;padding:10px 14px;border:1.5px solid var(--border);border-radius:12px;margin-top:8px;cursor:pointer;background:var(--surface)}
.ch:hover{border-color:var(--c-accent)}
.ch input{width:18px;height:18px;accent-color:var(--c-accent)}
.ch.right{border-color:var(--ok);background:rgba(21,128,61,.1)}
.ch.wrong{border-color:var(--err);background:rgba(220,38,38,.08)}
.score{width:170px;height:170px;border-radius:50%;margin:10px auto 18px;display:flex;flex-direction:column;align-items:center;justify-content:center;border:10px solid var(--c-accent);font:700 2.2rem var(--font);color:var(--head)}
.score small{font-size:.9rem;color:var(--muted)}
/* footer & bar */
footer{background:var(--c-footer);color:#cfd8ea;padding:40px 0 22px;margin-top:20px}
footer h4{color:var(--c-accent)}
.fgrid3{display:grid;grid-template-columns:2fr 1fr 1fr;gap:26px}
footer a:hover{color:var(--c-accent)}
footer .lnk{display:block;padding:3px 0}
.copy{border-top:1px solid rgba(255,255,255,.12);margin-top:22px;padding-top:14px;text-align:center;font-size:.88rem}
#cbar{position:fixed;bottom:0;inset-inline:0;z-index:600;background:var(--c-header);display:flex;justify-content:center;gap:4px;padding:6px 8px calc(6px + env(safe-area-inset-bottom,0px));box-shadow:0 -4px 18px rgba(0,0,0,.2)}
#cbar a{display:flex;flex-direction:column;align-items:center;gap:1px;color:#fff;font-size:.7rem;padding:4px 12px;border-radius:10px;min-width:54px}
#cbar a:hover{background:rgba(255,255,255,.14);color:var(--c-accent)}
body.adm #cbar,body.adm #ftr,body.adm #hdr{display:none}
/* modal / toast */
.ov{position:fixed;inset:0;background:rgba(5,12,28,.6);z-index:2000;display:flex;align-items:flex-start;justify-content:center;padding:4vh 12px;overflow:auto;backdrop-filter:blur(3px)}
.modal{background:var(--surface);color:var(--text);width:min(720px,100%);border-radius:var(--radius);padding:22px;box-shadow:0 20px 60px rgba(0,0,0,.4);animation:pop .2s}
.modal.lg{width:min(1000px,100%)}
@keyframes pop{from{transform:translateY(14px);opacity:0}}
.mh{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.mh h3{margin:0}
.mf{display:flex;gap:10px;justify-content:flex-end;margin-top:12px;flex-wrap:wrap}
#toasts{position:fixed;top:14px;inset-inline:0;z-index:3000;display:flex;flex-direction:column;align-items:center;gap:8px;pointer-events:none}
.toast{background:var(--c-primary);color:#fff;padding:11px 20px;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.3);font-weight:600;animation:pop .25s;border-inline-start:5px solid var(--c-accent);max-width:92vw}
.toast.err{border-color:var(--err)}
.toast.ok{border-color:var(--ok)}
.login{max-width:430px;margin:30px auto}
.login .brandc{text-align:center}
.login .brandc img{width:84px;height:84px;border-radius:20px;object-fit:cover;margin-bottom:8px}
/* admin */
.adm-wrap{display:flex;min-height:100vh}
.side{width:250px;background:var(--c-primary);color:#e8edf7;padding:14px 10px;position:sticky;top:0;height:100vh;overflow-y:auto;flex-shrink:0;z-index:700}
.side .sb{display:flex;align-items:center;gap:10px;padding:8px 10px 16px;font:700 1.1rem var(--fontH);color:#fff}
.side .sb img{width:38px;height:38px;border-radius:10px;background:#fff;object-fit:cover}
